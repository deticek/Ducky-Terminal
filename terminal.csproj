<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Ducky</AssemblyName>
    <Product>Ducky</Product>
    <Title>Ducky</Title>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeUrnik Condition="'$(IncludeUrnik)' == ''">true</IncludeUrnik>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Exclr8.Terminal" Version="1.0.9" />
    <PackageReference Include="Exclr8.Terminal.Pty" Version="1.0.4" />
  </ItemGroup>
  <ItemGroup> 
  <Compile Remove="Config\Commands\**\*.cs" />
  <ProjectReference Include="Config\Commands\Hello\hello.csproj" ReferenceOutputAssembly="false" />
  <ProjectReference Include="Config\Commands\Password\password.csproj" />
  <ProjectReference Include="Config\Commands\Urnik\urnik.csproj" ReferenceOutputAssembly="false" Condition="'$(IncludeUrnik)' == 'true'" />
  <None Update="Config\config.json" CopyToOutputDirectory="PreserveNewest" />
  <None Update="Themes\**\*.json" CopyToOutputDirectory="PreserveNewest" />

  <AvaloniaResource Include="Assets\logo.ico" />
  </ItemGroup>

  <Target Name="CopyCustomCommandsToPublish" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)Config\Commands" />
    <WriteLinesToFile File="$(PublishDir).ducky-published" Lines="Ducky publish output" Overwrite="true" />
    <ItemGroup>
      <_PublishedCommand Include="$(MSBuildProjectDirectory)\Config\Commands\hello.exe;$(MSBuildProjectDirectory)\Config\Commands\hello.dll;$(MSBuildProjectDirectory)\Config\Commands\hello.deps.json;$(MSBuildProjectDirectory)\Config\Commands\hello.runtimeconfig.json" />
      <_PublishedCommand Include="$(MSBuildProjectDirectory)\Config\Commands\password.exe;$(MSBuildProjectDirectory)\Config\Commands\password.dll;$(MSBuildProjectDirectory)\Config\Commands\password.deps.json;$(MSBuildProjectDirectory)\Config\Commands\password.runtimeconfig.json" />
      <_PublishedCommand Include="$(MSBuildProjectDirectory)\Config\Commands\urnik.exe;$(MSBuildProjectDirectory)\Config\Commands\urnik.dll;$(MSBuildProjectDirectory)\Config\Commands\urnik.deps.json;$(MSBuildProjectDirectory)\Config\Commands\urnik.runtimeconfig.json;$(MSBuildProjectDirectory)\Config\Commands\HtmlAgilityPack.dll" Condition="'$(IncludeUrnik)' == 'true'" />
    </ItemGroup>
    <Copy SourceFiles="@(_PublishedCommand)" DestinationFolder="$(PublishDir)Config\Commands" SkipUnchangedFiles="true" />
  </Target>
</Project>
