<Window xmlns="https://github.com/avaloniaui"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     x:Class="terminal.MainWindow"
     Title="Dterminal"
     Width="1100"
     Height="700"
     MinWidth="600"
     MinHeight="400"
     Background="#ECE9D8">

<DockPanel Background="#ECE9D8">

    <!-- Navigacijska vrstica v slogu Windows XP -->
    <Border x:Name="NavbarBorder"
            DockPanel.Dock="Top"
            Background="#D4D0C8"
            Padding="8"
            BorderBrush="#FFFFFF"
            BorderThickness="0,0,0,1">

        <StackPanel Orientation="Horizontal"
                    Spacing="8">

            <TextBlock x:Name="BrandText"
                       Text="Dterminal"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#000000"
                       VerticalAlignment="Center"
                       Margin="4,0,12,0"/>

            <Button x:Name="SplitButton"
                    Content="+ Split pane"
                    Background="#D4D0C8"
                    Foreground="#000000"
                    BorderBrush="#808080"
                    BorderThickness="1"
                    Padding="10,5"
                    FontSize="13"
                    Click="OnSplitClicked"/>
                
            <ComboBox x:Name="ThemeSelector"
          Width="150"
          VerticalAlignment="Center"
          SelectionChanged="OnThemeSelectionChanged"/>

        </StackPanel>
    </Border>

    <!-- Terminal -->
    <Border Background="#000000"
            BorderBrush="#7F9DB9"
            BorderThickness="1">

        <Grid x:Name="TerminalHost"
              ColumnDefinitions="*"
              Background="#000000"/>

    </Border>

</DockPanel>
</Window>